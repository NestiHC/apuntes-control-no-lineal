  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">38</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [dz1e,dz2e,dz3e] = fcn(z1e,z2e,z3e,e,u)

b=1;
K1=0.459e+3;     %6
K2=1.1562e+3;    %21
K3=8.6543e+3;    %23

dz1e = z2e + K1*e;

dz2e = z3e + b*u + K2*e;

dz3e = K3*e;</P>
      </eml>
    </state>
